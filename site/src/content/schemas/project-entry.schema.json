{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-entry.schema.json",
  "title": "Project Entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "excerpt",
    "venue",
    "venue_tag",
    "permalink",
    "date",
    "formatted_date",
    "category",
    "technologies",
    "github",
    "demo",
    "pdf",
    "presentation",
    "has_detail",
    "content_html"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string" },
    "venue": { "type": "string" },
    "venue_tag": { "type": "string" },
    "permalink": { "type": "string", "pattern": "^/" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "formatted_date": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "technologies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "github": { "type": ["string", "null"] },
    "demo": { "type": ["string", "null"] },
    "pdf": { "type": ["string", "null"] },
    "presentation": { "type": ["string", "null"] },
    "has_detail": { "type": "boolean" },
    "content_html": { "type": "string" }
  }
}
